{
  "$schema": "https://raw.githubusercontent.com/nicedoc/schemas/main/tauri/tauri.conf.v2.json",
  "productName": "Brightwing MCP Manager",
  "identifier": "com.brightwing.mcp-manager",
  "version": "0.3.7",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Brightwing MCP Manager",
        "width": 960,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis", "deb", "rpm", "appimage"],
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/brightwing-authd",
      "binaries/brightwing-proxy",
      "binaries/bw"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/192x192.png",
      "icons/512x512.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["brightwing"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhEMTA0RkRCNzA3OTEwNTQKUldSVUVIbHcyMDhRalY4elVQR0pjM1JpckN3NzNmRHphckxtS1ZBbWQrRzlrbjZHblZJL3RrNjYK",
      "endpoints": [
        "https://github.com/Brightwing-Systems-LLC/mcp-manager/releases/latest/download/latest.json"
      ]
    }
  }
}
